[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 banana : source_color = vec4(1.000000, 0.882353, 0.400000, 1.000000);
uniform vec4 banana3 : source_color = vec4(0.800000, 0.727117, 0.398777, 1.000000);
uniform sampler3D tex3d_frg_10;
uniform vec4 banana2 : source_color = vec4(0.000000, 0.000000, 0.000000, 1.000000);
uniform sampler3D tex3d_frg_5;
instance uniform float bruisedness : hint_range(0.0, 1.0) = 0.15000000596046;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = banana;


// ColorParameter:11
	vec4 n_out11p0 = banana3;


// Input:13
	vec2 n_out13p0 = UV;


// VectorOp:14
	vec3 n_in14p1 = vec3(2.00000, 2.00000, 2.00000);
	vec3 n_out14p0 = vec3(n_out13p0, 0.0) * n_in14p1;


	vec4 n_out10p0;
// Texture3D:10
	n_out10p0 = texture(tex3d_frg_10, n_out14p0);


// Mix:12
	vec3 n_out12p0 = mix(vec3(n_out2p0.xyz), vec3(n_out11p0.xyz), n_out10p0.x);


// ColorParameter:8
	vec4 n_out8p0 = banana2;


	vec4 n_out5p0;
// Texture3D:5
	n_out5p0 = texture(tex3d_frg_5, n_out14p0);


// FloatParameter:15
	float n_out15p0 = bruisedness;


// FloatOp:9
	float n_out9p0 = n_out5p0.x * n_out15p0;


// Mix:7
	vec3 n_out7p0 = mix(n_out12p0, vec3(n_out8p0.xyz), n_out9p0);


// Output:0
	ALBEDO = n_out7p0;


}
